---
// Full-page Modal for "Let's meet" / Contact
---

<div id="contactModal" class="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="modal-backdrop" id="modalBackdrop"></div>
  
  <div class="modal-container">
    <button id="closeModalBtn" class="modal-close" aria-label="Close dialog">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <div class="modal-header">
      <img src="/assets/flower.svg" alt="Embodied Llama emblem" class="modal-icon" width="48" height="48" />
      <span class="modal-badge">Somatic Coaching Discovery</span>
      <h2>Let's meet</h2>
      <p class="modal-subtitle">
        A dedicated space to connect, explore your somatic coaching goals, and sense if we are the right fit for your nervous system regulation journey.
      </p>
    </div>

    <!-- Embed Container (Cal.com / Calendly / Custom Booking) -->
    <div class="embed-box">
      <div class="embed-placeholder">
        <div class="placeholder-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#b68e54" stroke-width="1.75">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <h3>Booking Schedule Embed</h3>
        <p class="embed-note">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
        </p>
        <div class="fake-slots">
          <span class="fake-slot">10:00 AM</span>
          <span class="fake-slot active">11:30 AM</span>
          <span class="fake-slot">02:00 PM</span>
          <span class="fake-slot">03:30 PM</span>
        </div>
        <button class="embed-action-btn" type="button" onclick="alert('This is a demo embed placeholder. Your live scheduling system (e.g. Cal.com or Calendly) can be integrated here!')">
          Confirm Discovery Call (Sample)
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s;
  }

  .modal-overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(46, 49, 56, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .modal-container {
    position: relative;
    background: #FAF7F2;
    border: 1px solid #EBE2D6;
    border-radius: 1.5rem;
    max-width: 680px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 2.5rem 2rem;
    box-shadow: 0 25px 50px -12px rgba(46, 49, 56, 0.25);
    transform: scale(0.95) translateY(12px);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .modal-overlay.is-open .modal-container {
    transform: scale(1) translateY(0);
  }

  .modal-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    background: #EBE2D6;
    border: none;
    color: #2E3138;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .modal-close:hover {
    background: #b68e54;
    color: #ffffff;
    transform: rotate(90deg);
  }

  .modal-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .modal-icon {
    display: block;
    margin: 0 auto 0.75rem auto;
    filter: drop-shadow(0 4px 12px rgba(182, 142, 84, 0.2));
  }

  .modal-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #b68e54;
    background: rgba(182, 142, 84, 0.12);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .modal-header h2 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 2.25rem;
    color: #2E3138;
    font-weight: 600;
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .modal-subtitle {
    font-size: 0.95rem;
    color: #64748b;
    line-height: 1.6;
    max-width: 520px;
    margin: 0 auto;
  }

  .embed-box {
    background: #FFFFFF;
    border: 1px solid #EBE2D6;
    border-radius: 1rem;
    padding: 2rem 1.5rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }

  .embed-placeholder {
    text-align: center;
  }

  .placeholder-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(182, 142, 84, 0.1);
    margin-bottom: 1rem;
  }

  .embed-placeholder h3 {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 1.35rem;
    color: #2E3138;
    margin-bottom: 0.5rem;
  }

  .embed-note {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .fake-slots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .fake-slot {
    padding: 0.5rem 1rem;
    background: #FAF7F2;
    border: 1px solid #EBE2D6;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #2E3138;
    cursor: pointer;
    transition: all 0.2s;
  }

  .fake-slot.active, .fake-slot:hover {
    background: #b68e54;
    color: #ffffff;
    border-color: #b68e54;
  }

  .embed-action-btn {
    display: inline-block;
    width: 100%;
    padding: 0.85rem 1.5rem;
    background: #b68e54;
    color: #ffffff;
    border: none;
    border-radius: 9999px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(182, 142, 84, 0.3);
    transition: all 0.2s ease;
  }

  .embed-action-btn:hover {
    background: #9d7742;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(182, 142, 84, 0.4);
  }
</style>

<script>
  function setupModal() {
    const modal = document.getElementById('contactModal');
    const closeBtn = document.getElementById('closeModalBtn');
    const backdrop = document.getElementById('modalBackdrop');

    function openModal(e?: Event) {
      if (e) e.preventDefault();
      modal?.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      modal?.setAttribute('aria-hidden', 'false');
    }

    function closeModal() {
      modal?.classList.remove('is-open');
      document.body.style.overflow = '';
      modal?.setAttribute('aria-hidden', 'true');
    }

    document.querySelectorAll('[data-open-modal]').forEach((trigger) => {
      trigger.addEventListener('click', openModal);
    });

    closeBtn?.addEventListener('click', closeModal);
    backdrop?.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
        closeModal();
      }
    });
  }

  // Run on page load and on Astro page transitions
  setupModal();
  document.addEventListener('astro:page-load', setupModal);
</script>

