---
import BaseHead from '../components/BaseHead.astro';
import ContactModal from '../components/ContactModal.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: Record<string, any>;
}

const { title, description, image, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} schema={schema} />
    <slot name="head" />
  </head>
  <body>
    <!-- Top Brand Header Navigation -->
    <header class="site-header" id="siteHeader">
      <div class="nav-container">
        <!-- Main Nav Links Left -->
        <nav class="nav-menu" aria-label="Main Navigation">
          <a href="#method" class="nav-link">The Method</a>
          <a href="#about" class="nav-link">About Me</a>
          <a href="/articles" class="nav-link">Articles</a>
          <button type="button" class="nav-link nav-btn-link" data-open-modal>Contact</button>
        </nav>

        <!-- Brand Center -->
        <a href="/" class="brand-link" aria-label="Embodied Llama Somatic Coaching Homepage">
          <img src="/assets/logo.svg" alt="Embodied Llama Logo" class="brand-logo" width="36" height="36" />
          <div class="brand-text">
            <span class="brand-title">Embodied LLama</span>
            <span class="brand-tagline">SOMATIC COACHING</span>
          </div>
        </a>

        <!-- Right Quick Actions -->
        <div class="header-right">
          <button type="button" class="cta-pill-sm" data-open-modal>Let's meet</button>
          <a href="/admin" class="admin-portal-link" title="Micro-Admin Portal" aria-label="Admin Portal">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer with Minimal Glowing Circular Gradient -->
    <footer class="site-footer" id="siteFooter">
      <div class="footer-radial-glow"></div>
      <div class="footer-content">
        <a href="/" class="footer-brand">
          <img src="/assets/logo.svg" alt="Embodied Llama Logo" class="footer-logo" width="64" height="64" />
          <span class="footer-brand-title">Embodied LLama</span>
          <span class="footer-brand-subtitle">SOMATIC COACHING</span>
        </a>
        <p class="footer-mission">
          Guiding you out of survival mode and reconnecting with your true, authentic self through gentle, body-centered somatic coaching.
        </p>
        <div class="footer-links">
          <a href="#method">The Method</a>
          <a href="#about">About Me</a>
          <a href="/articles">Articles</a>
          <button type="button" class="footer-link-btn" data-open-modal>Contact</button>
          <a href="/admin">Admin Portal</a>
        </div>
        <p class="footer-copy">&copy; {new Date().getFullYear()} Embodied Llama. All rights reserved.</p>
      </div>
    </footer>

    <!-- Contact & Let's meet Full-page Modal -->
    <ContactModal />
  </body>
</html>

<style is:global>
  :root {
    --bg-canvas: #FAF7F2;
    --bg-surface: #EBE2D6;
    --text-primary: #2E3138;
    --text-muted: #64748B;
    --brand-gold: #B68E54;
    --brand-gold-hover: #9D7742;
    --brand-gold-subtle: rgba(182, 142, 84, 0.12);
    --font-heading: 'Fraunces', Georgia, serif;
    --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-body);
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    line-height: 1.6;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* Sticky Top Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 247, 242, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(235, 226, 214, 0.8);
    transition: all 0.3s ease;
    padding: 0.85rem 1.5rem;
  }

  .nav-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link, .nav-btn-link {
    text-decoration: none;
    color: #475569;
    font-size: 0.925rem;
    font-weight: 500;
    transition: color 0.2s ease;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
  }

  .nav-link:hover, .nav-btn-link:hover {
    color: var(--brand-gold);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-logo {
    display: block;
    width: 38px;
    height: 38px;
    object-fit: contain;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .brand-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--brand-gold);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .brand-tagline {
    font-size: 0.65rem;
    letter-spacing: 0.18em;
    font-weight: 600;
    color: var(--brand-gold);
    text-transform: uppercase;
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .cta-pill-sm {
    padding: 0.5rem 1.25rem;
    background: var(--brand-gold);
    color: #ffffff;
    border: none;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 2px 8px rgba(182, 142, 84, 0.25);
  }

  .cta-pill-sm:hover {
    background: var(--brand-gold-hover);
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(182, 142, 84, 0.35);
  }

  .admin-portal-link {
    color: #94a3b8;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    border-radius: 50%;
    transition: color 0.2s, background 0.2s;
  }

  .admin-portal-link:hover {
    color: var(--brand-gold);
    background: rgba(182, 142, 84, 0.1);
  }

  @media (max-width: 820px) {
    .nav-menu { display: none; }
  }

  #main-content {
    flex: 1;
    width: 100%;
  }

  /* Footer with Animated / Smooth Radial Aura */
  .site-footer {
    position: relative;
    overflow: hidden;
    padding: 5rem 1.5rem 3rem 1.5rem;
    background: #FAF7F2;
    border-top: 1px solid #EBE2D6;
    text-align: center;
  }

  .footer-radial-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 65%, #FFFDF8 0%, rgba(250, 247, 242, 0.75) 60%, #FAF7F2 100%);
    opacity: 0.85;
    pointer-events: none;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .site-footer:hover .footer-radial-glow {
    opacity: 1;
    transform: scale(1.04);
  }

  .footer-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-brand {
    text-decoration: none;
    margin-bottom: 1.5rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-logo {
    margin-bottom: 0.75rem;
    transition: transform 0.3s ease;
  }

  .footer-brand:hover .footer-logo {
    transform: scale(1.05);
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 1.85rem;
    color: var(--brand-gold);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .footer-brand-subtitle {
    font-size: 0.75rem;
    letter-spacing: 0.22em;
    font-weight: 600;
    color: var(--brand-gold);
    text-transform: uppercase;
  }

  .footer-mission {
    font-size: 0.975rem;
    color: #64748B;
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .footer-links a, .footer-link-btn {
    text-decoration: none;
    color: #475569;
    font-size: 0.9rem;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    font-family: inherit;
    padding: 0;
    transition: color 0.2s;
  }

  .footer-links a:hover, .footer-link-btn:hover {
    color: var(--brand-gold);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: #94A3B8;
  }
</style>
