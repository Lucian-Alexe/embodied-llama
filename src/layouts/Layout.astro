---
import '@fontsource/isometra';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';

import BaseHead from '../components/BaseHead.astro';
import ContactModal from '../components/ContactModal.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: Record<string, any>;
}

const { title, description, image, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} schema={schema} />
    <slot name="head" />
  </head>
  <body>
    <!-- Floating Minimal Top Menu (Links Only, single row on mobile) -->
    <header class="floating-nav-header" id="siteHeader">
      <nav class="nav-links-bar" aria-label="Main Navigation">
        <a href="#method" class="nav-link">The Method</a>
        <a href="#about" class="nav-link">About Me</a>
        <a href="#articles" class="nav-link">Articles</a>
        <button type="button" class="nav-link nav-btn-link" data-open-modal>Contact</button>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Footer with Large Llama Illustration and Smooth Looping Ambient Glow -->
    <footer class="site-footer" id="siteFooter">
      <div class="footer-radial-glow" aria-hidden="true"></div>
      <div class="footer-content">
        <!-- Big Llama Illustration as in PDF -->
        <img
          src="/assets/final-illustration.svg"
          alt="Embodied Llama Emblem"
          class="footer-big-illustration"
          width="360"
          height="324"
          loading="lazy"
        />
        
        <div class="footer-brand">
          <span class="footer-brand-title">Embodied LLama</span>
          <span class="footer-brand-subtitle">SOMATIC COACHING</span>
        </div>

        <div class="footer-links">
          <a href="#method">The Method</a>
          <a href="#about">About Me</a>
          <a href="#articles">Articles</a>
          <button type="button" class="footer-link-btn" data-open-modal>Contact</button>
          <a href="/admin">Admin</a>
        </div>
        
        <p class="footer-copy">&copy; {new Date().getFullYear()} Embodied Llama. All rights reserved.</p>
      </div>
    </footer>

    <!-- Contact & Let's meet Full-page Modal -->
    <ContactModal />
  </body>
</html>

<style is:global>
  :root {
    --bg-canvas: #FAF7F2;
    --bg-surface: #EBE2D6;
    --text-primary: #2E3138;
    --text-muted: #575A61;
    --brand-gold: #B68E54;
    --brand-gold-hover: #9D7742;
    --font-heading: 'Isometra', serif;
    --font-body: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-body);
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-size: 18px;
    line-height: 1.65;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }

  /* Floating Minimal Header (Links Only, Single Row) */
  .floating-nav-header {
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.85rem 1.25rem;
    display: flex;
    justify-content: center;
    background: rgba(250, 247, 242, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .nav-links-bar {
    display: flex;
    align-items: center;
    gap: 2.75rem;
    white-space: nowrap;
  }

  .nav-link, .nav-btn-link {
    text-decoration: none;
    color: #4A4D54;
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    white-space: nowrap;
  }

  .nav-link:hover, .nav-btn-link:hover {
    color: var(--brand-gold);
  }

  #main-content {
    flex: 1;
    width: 100%;
  }

  /* Buttons: Clean, flat, NO artificial glow */
  .btn-primary {
    display: inline-block;
    padding: 0.85rem 2.5rem;
    background: var(--brand-gold);
    color: #ffffff;
    border: none;
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    box-shadow: none;
    text-decoration: none;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .btn-primary:hover {
    background: var(--brand-gold-hover);
    transform: translateY(-1px);
    box-shadow: none;
  }

  /* Footer Section with Large Llama & Looping Glow */
  .site-footer {
    position: relative;
    overflow: hidden;
    padding: 5.5rem 1.5rem 4rem 1.5rem;
    background: #1e222a;
    color: #f5f3ef;
    text-align: center;
  }

  /* Ambient radial glow that loops continuously without user interaction */
  .footer-radial-glow {
    position: absolute;
    top: 38%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(182, 142, 84, 0.22) 0%, rgba(45, 54, 70, 0.42) 45%, rgba(30, 34, 42, 0) 70%);
    pointer-events: none;
    animation: footerLoopGlow 7s ease-in-out infinite alternate;
  }

  @keyframes footerLoopGlow {
    0% {
      opacity: 0.35;
      transform: translate(-50%, -50%) scale(0.92);
      filter: blur(25px);
    }
    50% {
      opacity: 0.85;
      transform: translate(-50%, -50%) scale(1.10);
      filter: blur(35px);
    }
    100% {
      opacity: 0.45;
      transform: translate(-50%, -50%) scale(0.96);
      filter: blur(28px);
    }
  }

  .footer-content {
    position: relative;
    z-index: 1;
    max-width: 650px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .footer-big-illustration {
    display: block;
    width: 320px;
    max-width: 85vw;
    height: auto;
    margin-bottom: 1.75rem;
    transition: transform 0.4s ease;
  }
  .footer-big-illustration:hover {
    transform: scale(1.02);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 1.75rem;
  }

  /* Footer title smaller as requested */
  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: #f5f3ef;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .footer-brand-subtitle {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.24em;
    font-weight: 600;
    color: var(--brand-gold);
    text-transform: uppercase;
    margin-top: 0.35rem;
  }

  /* Corrected line-height and spacing in footer links */
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem 1.75rem;
    line-height: 1.3;
    margin-bottom: 2rem;
  }

  .footer-links a, .footer-link-btn {
    text-decoration: none;
    color: #b3b7bf;
    font-size: 0.95rem;
    font-family: var(--font-body);
    line-height: 1.3;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }

  .footer-links a:hover, .footer-link-btn:hover {
    color: var(--brand-gold);
  }

  .footer-copy {
    font-size: 0.82rem;
    color: #787d88;
    line-height: 1.4;
  }

  /* Mobile menu buttons & headings */
  @media (max-width: 640px) {
    .floating-nav-header {
      padding: 0.65rem 0.75rem;
    }
    .nav-links-bar {
      gap: 1.15rem;
    }
    .nav-link, .nav-btn-link {
      font-size: 0.85rem;
    }
    .footer-links {
      gap: 0.65rem 1.25rem;
      line-height: 1.3;
    }
    .footer-brand-title {
      font-size: 1.5rem;
    }
  }
</style>
