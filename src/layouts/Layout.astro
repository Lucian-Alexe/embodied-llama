---
import '@fontsource/isometra';
import '@fontsource/geist-sans/200.css';
import '@fontsource/geist-sans/300.css';
import '@fontsource/geist-sans/400.css';
import '@fontsource/geist-sans/500.css';
import '@fontsource/geist-sans/600.css';
import '@fontsource/geist-sans/700.css';

import BaseHead from '../components/BaseHead.astro';
import ContactModal from '../components/ContactModal.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: Record<string, any>;
}

const { title, description, image, schema } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} schema={schema} />
    <slot name="head" />
  </head>
  <body>
    <!-- Clean Pure White Header as requested -->
    <header class="site-header" id="siteHeader">
      <div class="header-inner">
        <!-- Brand logo on mobile (hidden on desktop to match v3 centered links) -->
        <a href="/" class="mobile-brand-link" aria-label="Embodied Llama Home">
          <span class="mobile-brand-title">Embodied LLama</span>
        </a>

        <!-- Desktop Navigation Bar with Scrollspy Underline -->
        <nav class="desktop-nav" aria-label="Main Navigation">
          <a href="/#home" class="nav-item is-active" data-section="home">Home</a>
          <a href="/#magic" class="nav-item" data-section="magic">The Magic</a>
          <a href="/#about" class="nav-item" data-section="about">About Me</a>
          <a href="/#articles" class="nav-item" data-section="articles">Articles</a>
          <a href="https://zcal.com" target="_blank" rel="noopener noreferrer" class="btn-pill-dark nav-cta-book">
            <span>Book</span>
            <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
        </nav>

        <!-- Mobile Hamburger Toggle -->
        <button
          type="button"
          class="mobile-hamburger-btn"
          id="mobileMenuToggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobileMenuDrawer"
        >
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </button>
      </div>

      <!-- Mobile Slide-Down Navigation Drawer -->
      <div class="mobile-drawer" id="mobileMenuDrawer" aria-hidden="true">
        <nav class="mobile-nav-links" aria-label="Mobile Navigation">
          <a href="/#home" class="mobile-nav-item">Home</a>
          <a href="/#magic" class="mobile-nav-item">The Magic</a>
          <a href="/#about" class="mobile-nav-item">About Me</a>
          <a href="/#articles" class="mobile-nav-item">Articles</a>
          <div class="mobile-drawer-cta">
            <a href="https://zcal.com" target="_blank" rel="noopener noreferrer" class="btn-pill-dark btn-block mobile-book-btn">
              <span>Book</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <!-- Simple, Clean Sand Footer as requested -->
    <footer class="site-footer" id="siteFooter">
      <div class="footer-container">
        <div class="footer-brand">
          <span class="footer-brand-title">Embodied LLama</span>
          <span class="footer-brand-subtitle">SOMATIC COACHING</span>
        </div>

        <nav class="footer-nav" aria-label="Footer Navigation">
          <a href="/#home">Home</a>
          <a href="/#magic">The Magic</a>
          <a href="/#about">About Me</a>
          <a href="/#articles">Articles</a>
          <a href="/admin">Admin</a>
        </nav>

        <p class="footer-copy">&copy; {new Date().getFullYear()} Embodied Llama. All rights reserved.</p>
      </div>
    </footer>

    <!-- Contact modal kept for auxiliary routes if needed -->
    <ContactModal />

    <!-- Mobile Menu & ScrollSpy Interactivity -->
    <script>
      function setupHeaderNav() {
        const toggleBtn = document.getElementById('mobileMenuToggle');
        const drawer = document.getElementById('mobileMenuDrawer');
        const mobileLinks = drawer?.querySelectorAll('a, button');

        if (!toggleBtn || !drawer) return;

        function toggleMenu() {
          const isOpen = toggleBtn?.getAttribute('aria-expanded') === 'true';
          const nextState = !isOpen;

          toggleBtn?.setAttribute('aria-expanded', String(nextState));
          drawer?.setAttribute('aria-hidden', String(!nextState));
          toggleBtn?.classList.toggle('is-active', nextState);
          drawer?.classList.toggle('is-open', nextState);
          document.body.classList.toggle('mobile-menu-locked', nextState);
        }

        function closeMenu() {
          toggleBtn?.setAttribute('aria-expanded', 'false');
          drawer?.setAttribute('aria-hidden', 'true');
          toggleBtn?.classList.remove('is-active');
          drawer?.classList.remove('is-open');
          document.body.classList.remove('mobile-menu-locked');
        }

        toggleBtn.addEventListener('click', toggleMenu);

        mobileLinks?.forEach((link) => {
          link.addEventListener('click', closeMenu);
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
            closeMenu();
          }
        });

        // Close when clicking outside header
        document.addEventListener('click', (e) => {
          const header = document.getElementById('siteHeader');
          if (drawer.classList.contains('is-open') && header && !header.contains(e.target as Node)) {
            closeMenu();
          }
        });
      }

      function setupScrollSpy() {
        const sections = ['home', 'magic', 'about', 'articles'];
        const navLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav .nav-item[data-section]');
        if (!navLinks.length) return;

        function updateSpy() {
          const scrollPosition = window.scrollY;
          const headerOffset = 130;
          let activeSection = 'home';

          for (const id of sections) {
            const el = document.getElementById(id);
            if (el) {
              const top = el.offsetTop - headerOffset;
              if (scrollPosition >= top) {
                activeSection = id;
              }
            }
          }

          navLinks.forEach((link) => {
            const sec = link.getAttribute('data-section');
            link.classList.toggle('is-active', sec === activeSection);
          });
        }

        window.addEventListener('scroll', updateSpy, { passive: true });
        updateSpy();
      }

      setupHeaderNav();
      setupScrollSpy();
      document.addEventListener('astro:page-load', () => {
        setupHeaderNav();
        setupScrollSpy();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-canvas: #FBF8F4;
    --bg-surface: #EDE4D8;
    --bg-card: #FFFFFF;
    --border-subtle: rgba(217, 215, 211, 0.7);
    --text-primary: #2E3138;
    --text-secondary: #5E626B;
    --brand-ochre: #B68E54;
    --brand-ochre-hover: #9E7943;
    --brand-dark-btn: #2E3138;
    --brand-dark-btn-hover: #1A1C20;
    --font-heading: 'Isometra', serif;
    --font-body: 'Geist Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-family: var(--font-body);
    background-color: var(--bg-canvas);
    color: var(--text-primary);
    font-size: 18px;
    line-height: 1.65;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    background-color: var(--bg-canvas);
  }

  body.mobile-menu-locked {
    overflow: hidden;
  }

  #main-content {
    flex: 1;
    width: 100%;
  }

  /* Universal Sticky Header (Pure White, Flat, No Shadow) */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background: #FFFFFF;
    border-bottom: 1px solid rgba(217, 215, 211, 0.5);
    box-shadow: none;
    transition: background-color 0.3s ease;
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1.1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Mobile Brand link (hidden on desktop) */
  .mobile-brand-link {
    display: none;
    text-decoration: none;
    color: var(--brand-ochre);
  }

  .mobile-brand-title {
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    display: inline-block;
    color: var(--brand-ochre);
  }

  /* Desktop Nav Bar (Centered to match v3 mockup) */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 3.25rem;
  }

  .nav-item, .nav-btn-link {
    text-decoration: none;
    color: #4A4D54;
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 400;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.25rem 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-item:hover, .nav-btn-link:hover {
    color: var(--text-primary);
  }

  .nav-item.is-active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--text-primary);
  }

  /* Dark Pill Button (as in v3 top right) */
  .btn-pill-dark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 1.6rem;
    background: var(--brand-dark-btn);
    color: #FFFFFF;
    font-family: var(--font-body);
    font-size: 0.98rem;
    font-weight: 500;
    border-radius: 9999px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    box-shadow: none;
    transition: background-color 0.2s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .btn-pill-dark:hover {
    background: var(--brand-dark-btn-hover);
    transform: translateY(-1px);
  }

  .btn-arrow {
    display: inline-block;
    transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    font-size: 1.05rem;
    line-height: 1;
  }

  .btn-pill-dark:hover .btn-arrow,
  .btn-pill-ochre:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  /* Mobile Hamburger Button */
  .mobile-hamburger-btn {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    z-index: 101;
  }

  .hamburger-bar {
    display: block;
    width: 22px;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .mobile-hamburger-btn.is-active .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .mobile-hamburger-btn.is-active .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-hamburger-btn.is-active .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Drawer Menu (Pure White, Flat, No Shadow) */
  .mobile-drawer {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #FFFFFF;
    border-bottom: 1px solid var(--border-subtle);
    padding: 2rem 2rem 2.5rem;
    box-shadow: none;
    transform: translateY(-10px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.28s cubic-bezier(0.16, 1, 0.3, 1), transform 0.28s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-drawer.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    text-align: center;
  }

  .mobile-nav-item, .mobile-nav-btn {
    text-decoration: none;
    font-size: 1.25rem;
    color: var(--text-primary);
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.35rem 1rem;
    transition: color 0.2s ease;
  }

  .mobile-nav-item:hover, .mobile-nav-btn:hover {
    color: var(--brand-ochre);
  }

  .mobile-drawer-cta {
    width: 100%;
    max-width: 280px;
    margin-top: 0.75rem;
  }

  .btn-block {
    width: 100%;
    padding: 0.85rem 1.5rem;
  }

  /* Simple Sand Footer (per user request) */
  .site-footer {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    padding: 5rem 1.5rem 3.5rem;
    border-top: 1px solid rgba(217, 215, 211, 0.6);
  }

  .footer-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 2.25rem;
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--brand-ochre);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .footer-brand-subtitle {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    font-weight: 600;
    color: var(--text-primary);
    text-transform: uppercase;
    margin-top: 0.35rem;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.25rem 2.5rem;
    margin-bottom: 2.5rem;
  }

  .footer-nav a, .footer-link-btn {
    text-decoration: none;
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 500;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.2rem 0;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover, .footer-link-btn:hover {
    color: var(--text-primary);
  }

  .footer-copy {
    font-size: 0.88rem;
    color: #7A7E87;
    line-height: 1.4;
  }

  /* Responsive Breakpoint for Mobile Nav */
  @media (max-width: 860px) {
    .header-inner {
      justify-content: space-between;
      padding: 0.9rem 1.5rem;
    }

    .desktop-nav {
      display: none;
    }

    .mobile-brand-link {
      display: block;
    }

    .mobile-hamburger-btn {
      display: flex;
    }

    .mobile-drawer {
      display: block;
    }

    .footer-nav {
      gap: 0.85rem 1.75rem;
    }
  }
</style>
