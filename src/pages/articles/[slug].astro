---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getD1, getArticleBySlug } from '../../lib/db';

const { slug } = Astro.params;
const d1 = getD1(Astro.locals);
const article = slug ? await getArticleBySlug(d1, slug) : null;

if (!article || article.status !== 'published') {
  return Astro.redirect('/404');
}

// Simple markdown converter for headings, bold, italics, images, code, paragraphs
function renderMarkdown(md: string): string {
  return md
    .replace(/^### (.*$)/gim, '<h3>$1</h3>')
    .replace(/^## (.*$)/gim, '<h2>$1</h2>')
    .replace(/^# (.*$)/gim, '<h1>$1</h1>')
    .replace(/!\[(.*?)\]\((.*?)\)/gim, (_match, alt, src) => {
      const caption = alt ? `<figcaption class="article-caption">${alt}</figcaption>` : '';
      return `<figure class="article-figure"><img src="${src}" alt="${alt}" class="article-img" loading="lazy" />${caption}</figure>`;
    })
    .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/gim, '<em>$1</em>')
    .replace(/`([^`]+)`/gim, '<code>$1</code>')
    .replace(/\n\n/gim, '</p><p>')
    .replace(/\n/gim, '<br/>');
}

const htmlContent = renderMarkdown(article.content);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.created_at,
  dateModified: article.updated_at,
  author: {
    '@type': 'Organization',
    name: 'Embodied Llama',
  },
};
---

<Layout
  title={article.title}
  description={article.description || `Read ${article.title} on Embodied Llama.`}
  schema={schema}
>
  <article class="article-container">
    <div class="article-header">
      <a href="/#articles" class="back-link">← All Articles</a>
      <h1>{article.title}</h1>
      {article.description && <p class="article-lead">{article.description}</p>}
      <div class="article-meta">
        <time datetime={article.created_at}>
          Published on {new Date(article.created_at || Date.now()).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>
    </div>

    <div class="article-body" set:html={`<p>${htmlContent}</p>`} />
  </article>
</Layout>

<style>
  .article-container {
    max-width: 820px;
    margin: 3.5rem auto 6rem;
    padding: 0 1.5rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--brand-ochre, #B68E54);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 2rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .back-link:hover {
    color: var(--brand-ochre-hover, #9E7943);
    transform: translateX(-3px);
  }
  .article-header {
    margin-bottom: 2.75rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle, rgba(217, 215, 211, 0.7));
  }
  h1 {
    font-size: 2.85rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
    color: var(--text-primary, #2E3138);
  }
  .article-lead {
    font-size: 1.22rem;
    color: var(--text-secondary, #5E626B);
    line-height: 1.65;
    margin-bottom: 1.25rem;
  }
  .article-meta {
    font-size: 0.9rem;
    color: #8C909A;
  }
  .article-body {
    font-size: 1.12rem;
    line-height: 1.85;
    color: var(--text-primary, #2E3138);
  }
  .article-body :global(h2) {
    font-size: 1.85rem;
    margin: 2.5rem 0 1rem 0;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-primary, #2E3138);
  }
  .article-body :global(h3) {
    font-size: 1.4rem;
    margin: 2rem 0 0.85rem 0;
    font-weight: 600;
    color: var(--text-primary, #2E3138);
  }
  .article-body :global(p) {
    margin-bottom: 1.4rem;
  }
  .article-body :global(code) {
    background: #EDE4D8;
    color: var(--text-primary, #2E3138);
    padding: 0.2rem 0.45rem;
    border-radius: 0.35rem;
    font-size: 0.92em;
  }
  .article-body :global(.article-figure) {
    margin: 2.5rem 0;
    text-align: center;
  }
  .article-body :global(.article-img) {
    max-width: 100%;
    height: auto;
    border-radius: 20px;
    display: block;
    margin: 0 auto;
    box-shadow: none;
  }
  .article-body :global(figcaption) {
    font-size: 0.88rem;
    color: var(--text-secondary, #5E626B);
    margin-top: 0.75rem;
    font-style: italic;
  }
</style>
