---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getD1, getArticleBySlug } from '../../lib/db';

const { slug } = Astro.params;
const d1 = getD1(Astro.locals);
const article = slug ? await getArticleBySlug(d1, slug) : null;

if (!article || article.status !== 'published') {
  return Astro.redirect('/404');
}

// Simple markdown converter for headings, bold, italics, code, paragraphs
function renderMarkdown(md: string): string {
  return md
    .replace(/^### (.*$)/gim, '<h3>$1</h3>')
    .replace(/^## (.*$)/gim, '<h2>$1</h2>')
    .replace(/^# (.*$)/gim, '<h1>$1</h1>')
    .replace(/\*\*(.*?)\*\*/gim, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/gim, '<em>$1</em>')
    .replace(/`([^`]+)`/gim, '<code>$1</code>')
    .replace(/\n\n/gim, '</p><p>')
    .replace(/\n/gim, '<br/>');
}

const htmlContent = renderMarkdown(article.content);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description: article.description,
  datePublished: article.created_at,
  dateModified: article.updated_at,
  author: {
    '@type': 'Organization',
    name: 'Embodied Llama',
  },
};
---

<Layout
  title={article.title}
  description={article.description || `Read ${article.title} on Embodied Llama.`}
  schema={schema}
>
  <article class="article-container">
    <div class="article-header">
      <a href="/articles" class="back-link">← All Articles</a>
      <h1>{article.title}</h1>
      {article.description && <p class="article-lead">{article.description}</p>}
      <div class="article-meta">
        <time datetime={article.created_at}>
          Published on {new Date(article.created_at || Date.now()).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>
    </div>

    <div class="article-body" set:html={`<p>${htmlContent}</p>`} />
  </article>
</Layout>

<style>
  .article-container {
    max-width: 780px;
    margin: 2rem auto;
    padding: 0 1rem;
  }
  .back-link {
    display: inline-block;
    color: var(--primary-color, #2563eb);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }
  .article-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-color, #e2e8f0);
  }
  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .article-lead {
    font-size: 1.2rem;
    color: #475569;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  .article-meta {
    font-size: 0.875rem;
    color: #94a3b8;
  }
  .article-body {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--text-color, #1e293b);
  }
  .article-body :global(h2) {
    font-size: 1.75rem;
    margin: 2rem 0 1rem 0;
    font-weight: 700;
  }
  .article-body :global(h3) {
    font-size: 1.35rem;
    margin: 1.5rem 0 0.75rem 0;
    font-weight: 600;
  }
  .article-body :global(p) {
    margin-bottom: 1.25rem;
  }
  .article-body :global(code) {
    background: #f1f5f9;
    padding: 0.2rem 0.4rem;
    border-radius: 0.3rem;
    font-size: 0.95em;
  }
</style>

