---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getD1, getAllArticles } from '../lib/db';

const d1 = getD1(Astro.locals);
const allArticles = await getAllArticles(d1);
const latestArticles = allArticles.filter((a) => a.status === 'published').slice(0, 4);

const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://embodiedllama.com/#website',
      url: 'https://embodiedllama.com',
      name: 'Embodied Llama',
      description: 'Transformative somatic coaching, nervous system regulation, and body-centered practices.',
    },
    {
      '@type': ['ProfessionalService', 'HealthAndBeautyBusiness'],
      '@id': 'https://embodiedllama.com/#service',
      name: 'Embodied Llama Somatic Coaching',
      url: 'https://embodiedllama.com',
      logo: 'https://embodiedllama.com/assets/logo.svg',
      image: 'https://embodiedllama.com/assets/photos/hero-portrait.jpeg',
      description: 'Guiding individuals out of survival mode and into authentic self-alignment using nervous system regulation, somatic touch, TTT tapping, and body-centered awareness.',
      serviceType: 'Somatic Coaching',
      priceRange: '$$',
      areaServed: ['Chicago', 'United States', 'Worldwide (Remote)'],
      knowsAbout: [
        'Somatic Coaching',
        'Nervous System Regulation',
        'Trauma-Informed Somatics',
        'Vagus Nerve Grounding',
        'Body Awareness',
      ],
    },
  ],
};
---

<Layout
  title="Home"
  description="Embodied Llama — Somatic Coaching to step out of survival mode, regulate your nervous system, and reconnect with the wisdom of your body."
  schema={seoSchema}
>
  <!-- ==================== HERO SECTION ==================== -->
  <section class="hero-section">
    <div class="container hero-container">
      <!-- Left: Portrait Photo with Arched Frame -->
      <div class="hero-media">
        <div class="arch-frame">
          <img
            src="/assets/photos/hero-portrait.jpeg"
            alt="Somatic coach smiling in nature — Embodied Llama somatic coaching"
            class="hero-img"
            width="480"
            height="640"
            loading="eager"
          />
        </div>
      </div>

      <!-- Right: Headline and 2-column narrative -->
      <div class="hero-content">
        <span class="sub-badge">Somatic Coaching Practice</span>
        <h1 class="hero-title">Returning to the<br />wisdom of your body</h1>

        <div class="hero-columns">
          <div class="hero-col">
            <p>
              <strong>Real transformation happens when we fully inhabit our physical experience.</strong> When we bring loving attention to the body, we unlock its natural capacity to heal and expand.
            </p>
            <p>
              Whether you are moving through a major transition, finding your way through stress, wanting to foster self-attunement and reconnecting with your true self, <em>somatic coaching meets you right where you are</em>. It offers a path to feel at home in your body and make choices that are aligned with your deepest truth, as you dive into the wisdom of your soma.
            </p>
          </div>

          <div class="hero-col">
            <p>
              This process is about creating tangible internal resources that become part of your daily life. We build a sense of safety in your nervous system and inner groundedness that gives you a steady anchor when life gets stressful.
            </p>
            <p>
              As you learn to meet your emotions with warmth and curiosity, you dissolve old habits that limited your capacity to thrive and make room for genuine joy and presence, allowing you to move through life feeling centered.
            </p>
          </div>
        </div>

        <div class="hero-actions">
          <button type="button" class="btn-primary" data-open-modal>Let's meet</button>
        </div>
      </div>
    </div>

    <!-- Llama Wisdom Callout Card -->
    <div class="container">
      <div class="callout-card">
        <div class="callout-inner">
          <p>
            My practice is named after the llama for a special reason. Llamas are not only cute and gentle, beneath their soft exterior they are also incredibly strong and resilient. They carry heavy loads through difficult paths with steadiness. They teach us about the profound value of community and service while they also remind us to protect our energy when our limits are pushed. They are experts at setting boundaries with humor! Llamas show us that we can be soft and compassionate while staying rooted in our power.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== THE METHOD / HOW THE MAGIC HAPPENS ==================== -->
  <section class="method-section" id="method">
    <div class="container text-center">
      <h2 class="section-title">How the magic happens</h2>
      <div class="method-intro">
        <p>
          As a Somatic Coach, I offer a warm compassionate environment where every part of you is welcome. We focus on shifting away from self-criticism toward self-compassion. Together, we guide your nervous system out of survival mode into safety, using practical grounding techniques. We create a safe space for feelings to move through freely, and allow old emotional tension to release safely.
        </p>
        <p>
          Because your healing journey is completely unique to you, we co-create a personalized program tailored entirely to what you need in the present moment. Rooted in what feels most supportive for you, we can draw from a rich blend of integrative modalities. In our sessions, we can incorporate gentle yoga, different breathing techniques, somatic touch, body scans and TTT tapping. We can also include movement, visualization and NLP along with other intuitive tools.
        </p>
      </div>

      <!-- Golden Highlight Banner -->
      <div class="golden-banner">
        <img src="/assets/flower.svg" alt="Somatic wellness floral emblem" class="banner-flower" width="44" height="44" />
        <h3 class="banner-heading">
          Rather than just managing symptoms, these tools help you build true internal resilience and reconnect with your intuition, yourself and the world around you.
        </h3>
        <p class="banner-sub">Here is what we weave in our sessions:</p>
      </div>

      <!-- 4 Method Pillar Cards -->
      <div class="pillars-grid">
        <!-- Pillar 1 -->
        <div class="pillar-card">
          <div class="pillar-icon-box">
            <img src="/assets/icon-1.svg" alt="Nervous System Regulation - Somatic Coaching" class="pillar-icon" width="60" height="60" />
          </div>
          <h4 class="pillar-title">Nervous System<br />Regulation</h4>
          <p class="pillar-desc">
            Shifting out of hypervigilance into practical grounding techniques that soothe anxiety and teach your system that it is safe to relax.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="pillar-card">
          <div class="pillar-icon-box">
            <img src="/assets/icon-2.svg" alt="Befriending Your Body - Somatic Healing" class="pillar-icon" width="60" height="60" />
          </div>
          <h4 class="pillar-title">Befriending Your<br />Body</h4>
          <p class="pillar-desc">
            Shifting from resisting or judging your physical self to treating your body as a trusted ally.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="pillar-card">
          <div class="pillar-icon-box">
            <img src="/assets/icon-3.svg" alt="Creating Space for Emotion - Somatic Coaching" class="pillar-icon" width="60" height="60" />
          </div>
          <h4 class="pillar-title">Creating Space for<br />Emotion</h4>
          <p class="pillar-desc">
            Allowing feelings to move through you freely, turning emotional weight into clarity and wisdom.
          </p>
        </div>

        <!-- Pillar 4 -->
        <div class="pillar-card">
          <div class="pillar-icon-box">
            <img src="/assets/icon-4.svg" alt="Reclaiming Your Voice - Somatic Coaching" class="pillar-icon" width="60" height="60" />
          </div>
          <h4 class="pillar-title">Reclaiming Your Voice &<br />Reconnecting with Creation</h4>
          <p class="pillar-desc">
            Moving beyond daily survival so you can speak your truth, align with your deepest desires, and actively design your future.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== ABOUT ME SECTION ==================== -->
  <section class="about-section" id="about">
    <div class="container">
      <h2 class="section-title text-center">About me</h2>

      <div class="about-grid">
        <!-- Column 1 -->
        <div class="about-col">
          <div class="about-item">
            <h3>Proudly Mexican:</h3>
            <p>I am deeply proud of my roots and love sharing the warm and vibrant energy of Mexico wherever I go.</p>
          </div>

          <div class="about-item">
            <h3>Powered by:</h3>
            <p>Dogs, good coffee, tarot readings, the beach, sound healing and cacao ceremonies. Also, full transparency, an iced Coke!</p>
          </div>

          <div class="about-item">
            <h3>Rooted in Connection:</h3>
            <p>Deep, authentic connection with my loved ones and community is what keeps my heart full.</p>
          </div>

          <div class="about-item">
            <h3>Wanderer at Heart:</h3>
            <p>I love traveling, exploring new cultures, and connecting with people. Relocating to Chicago was one of the most incredible and challenging experiences.</p>
          </div>

          <div class="about-item">
            <h3>Movement is My First Language:</h3>
            <p>Dance has been a part of my life since I was 5 years old. It has always been my safe place and where I feel most alive.</p>
          </div>
        </div>

        <!-- Column 2 -->
        <div class="about-col">
          <div class="about-item">
            <h3>Yoga and Spirituality:</h3>
            <p>I’ve practiced yoga for over 12 years, not only the postures but a way of life that goes beyond the mat. Completing 500 YTT in India and Bali were deeply transformative experiences that make me who I am today. My spiritual practice is a loving foundation that helps me navigate life with hope.</p>
          </div>

          <div class="about-item">
            <h3>Seeker & Soul Explorer:</h3>
            <p>Fascinated by the depth of human consciousness, I am always learning. I love incorporating intuitive modalities like tarot and Quantum Healing as gentle tools for insight and inner growth.</p>
          </div>

          <div class="about-item">
            <h3>10+ Years of Holding Space:</h3>
            <p>I hold a bachelor’s in Psychology and a master’s in Psychoanalytic Psychotherapy. Before transitioning into somatic coaching, I spent over a decade working as a counselor in non-profits and private practices, specializing in relational and generational trauma. That journey brought me to mindfulness, EMDR, Brainspotting, and integrative somatic approaches. These tools shaped how I hold space today.</p>
          </div>
        </div>
      </div>

      <!-- Passion Statement Callout -->
      <div class="passion-box">
        <p>My real passion is guiding people to step out of survival mode and reconnect with their true selves.</p>
      </div>
    </div>

    <!-- Scroll-driven Parallax Photo Gallery Strip -->
    <div class="photo-strip-container" id="photoStripContainer">
      <div class="photo-strip" id="photoStrip">
        <div class="gallery-card">
          <img src="/assets/photos/about-1.jpeg" alt="Canyon exploration — Embodied somatic journey" class="gallery-img" loading="lazy" />
        </div>
        <div class="gallery-card">
          <img src="/assets/photos/about-2.jpeg" alt="Somatic coach outdoor connection in nature" class="gallery-img" loading="lazy" />
        </div>
        <div class="gallery-card">
          <img src="/assets/photos/about-3.jpeg" alt="Grounding somatic meditation session" class="gallery-img" loading="lazy" />
        </div>
        <div class="gallery-card">
          <img src="/assets/photos/about-4.jpeg" alt="Mexican textile vibrancy and heartfelt connection" class="gallery-img" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== LET'S CREATE A FUTURE ==================== -->
  <section class="future-section">
    <div class="future-watermark-wrap">
      <img src="/assets/final-illustration.svg" alt="" class="future-watermark" aria-hidden="true" />
    </div>

    <div class="container relative-z">
      <div class="future-content">
        <h2 class="future-title">Let’s create a future<br />that feels like you</h2>

        <div class="future-narrative">
          <p>
            My path to somatic coaching started while working with clients processing trauma. While I loved supporting them, we kept bumping into the same wall: retelling the story wasn’t enough. They were still holding onto old survival patterns and a nervous system stuck in fight-or-flight. I knew there was something missing.
          </p>
          <p>
            Everything shifted when I found body-centered practices. I realized that transformation only happens when the body is included in the process, and this resonated so much more with my approach to healing. Movement has always been my personal medicine, so bringing body awareness into my work felt completely natural.
          </p>
          <p>
            As a somatic coach, my greatest joy is guiding people back to their most authentic selves. I know this path deeply because I’ve walked my own journey of learning to slow down, listen to my body’s wisdom, and reconnect with my heart. I’m so honored to share this work with you!
          </p>
        </div>

        <div class="future-actions">
          <button type="button" class="btn-primary" data-open-modal>Let's meet</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== LATEST ARTICLES ==================== -->
  <section class="articles-section" id="articles">
    <div class="container">
      <h2 class="section-title text-center">Latest Articles</h2>
      <p class="section-sub text-center">Insights on somatic coaching, nervous system regulation, and embodied living.</p>

      <div class="articles-list">
        {latestArticles.map((art) => (
          <a href={`/articles/${art.slug}`} class="article-row">
            <span class="article-date">
              {new Date(art.created_at || Date.now()).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
            </span>
            <span class="article-title">{art.title}</span>
            <span class="article-arrow">→</span>
          </a>
        ))}
      </div>

      <div class="text-center mt-3">
        <a href="/articles" class="btn-outline-gold">Load More</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Base Container */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }
  .text-center { text-align: center; }
  .relative-z { position: relative; z-index: 2; }
  .mt-3 { margin-top: 2.5rem; }

  /* Reusable Buttons */
  .btn-primary {
    display: inline-block;
    padding: 0.95rem 2.25rem;
    background: #b68e54;
    color: #ffffff;
    border: none;
    border-radius: 9999px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(182, 142, 84, 0.3);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .btn-primary:hover {
    background: #9d7742;
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(182, 142, 84, 0.4);
  }

  .btn-outline-gold {
    display: inline-block;
    padding: 0.8rem 2rem;
    background: transparent;
    color: #b68e54;
    border: 1.5px solid #b68e54;
    border-radius: 9999px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .btn-outline-gold:hover {
    background: #b68e54;
    color: #ffffff;
    transform: translateY(-2px);
  }

  .sub-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #b68e54;
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 2.65rem;
    font-weight: 600;
    color: #2E3138;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .section-sub {
    font-size: 1.05rem;
    color: #64748B;
    margin-bottom: 3rem;
  }

  /* ==================== HERO SECTION ==================== */
  .hero-section {
    padding: 3.5rem 0 4rem 0;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 3.5rem;
    align-items: center;
    margin-bottom: 3.5rem;
  }

  .hero-media {
    display: flex;
    justify-content: center;
  }

  .arch-frame {
    width: 100%;
    max-width: 380px;
    aspect-ratio: 3 / 4;
    border-top-left-radius: 190px;
    border-top-right-radius: 190px;
    border-bottom-left-radius: 1.5rem;
    border-bottom-right-radius: 1.5rem;
    overflow: hidden;
    box-shadow: 0 20px 40px -10px rgba(46, 49, 56, 0.15);
    background: #EBE2D6;
    border: 1px solid rgba(182, 142, 84, 0.2);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.6s ease;
  }
  .arch-frame:hover .hero-img {
    transform: scale(1.03);
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: 3.25rem;
    line-height: 1.15;
    font-weight: 600;
    color: #2E3138;
    letter-spacing: -0.025em;
    margin-bottom: 2rem;
  }

  .hero-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .hero-col p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #475569;
    margin-bottom: 1.25rem;
  }
  .hero-col p:last-child {
    margin-bottom: 0;
  }
  .hero-col strong {
    color: #2E3138;
  }

  /* Callout Card */
  .callout-card {
    background: rgba(235, 226, 214, 0.55);
    border: 1px solid #EBE2D6;
    border-radius: 1.25rem;
    padding: 2.25rem 2.5rem;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
  }

  .callout-inner p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #334155;
    text-align: center;
    max-width: 980px;
    margin: 0 auto;
    font-style: italic;
  }

  /* ==================== HOW THE MAGIC HAPPENS ==================== */
  .method-section {
    padding: 5rem 0;
    background: #FAF7F2;
  }

  .method-intro {
    max-width: 860px;
    margin: 0 auto 3rem auto;
  }
  .method-intro p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #475569;
    margin-bottom: 1.5rem;
  }

  .golden-banner {
    background: #b68e54;
    color: #ffffff;
    border-radius: 1.25rem;
    padding: 3rem 2.5rem;
    margin-bottom: 3.5rem;
    box-shadow: 0 10px 30px rgba(182, 142, 84, 0.25);
  }

  .banner-flower {
    margin-bottom: 1.25rem;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .banner-heading {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.4;
    max-width: 820px;
    margin: 0 auto 1.5rem auto;
  }

  .banner-sub {
    font-size: 1rem;
    opacity: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .pillar-card {
    background: #FFFFFF;
    border: 1px solid #EBE2D6;
    border-radius: 1.5rem;
    padding: 2.25rem 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .pillar-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(182, 142, 84, 0.15);
    border-color: #b68e54;
  }

  .pillar-icon-box {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  .pillar-icon {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .pillar-title {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    color: #2E3138;
    margin-bottom: 1rem;
    line-height: 1.3;
    min-height: 3.1rem;
  }

  .pillar-desc {
    font-size: 0.885rem;
    color: #64748B;
    line-height: 1.6;
  }

  /* ==================== ABOUT ME ==================== */
  .about-section {
    padding: 5rem 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    margin-bottom: 3rem;
  }

  .about-item {
    margin-bottom: 2rem;
  }
  .about-item h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    color: #b68e54;
    margin-bottom: 0.4rem;
  }
  .about-item p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #475569;
  }

  .passion-box {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3.5rem auto;
  }
  .passion-box p {
    font-family: var(--font-heading);
    font-size: 1.65rem;
    font-weight: 500;
    color: #2E3138;
    line-height: 1.4;
    font-style: italic;
  }

  /* Photo Strip with Scroll Movement */
  .photo-strip-container {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    overflow-x: hidden;
    padding: 1.5rem 0;
  }

  .photo-strip {
    display: flex;
    gap: 1.5rem;
    padding: 0 2rem;
    justify-content: center;
    transition: transform 0.15s ease-out;
  }

  .gallery-card {
    flex: 0 0 280px;
    height: 360px;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
    background: #EBE2D6;
  }

  .gallery-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  .gallery-card:hover .gallery-img {
    transform: scale(1.05);
  }

  /* ==================== FUTURE SECTION ==================== */
  .future-section {
    position: relative;
    padding: 6rem 0;
    background: #FAF7F2;
    overflow: hidden;
  }

  .future-watermark-wrap {
    position: absolute;
    right: -10%;
    top: 50%;
    transform: translateY(-50%);
    width: 550px;
    opacity: 0.14;
    pointer-events: none;
  }
  .future-watermark {
    width: 100%;
    height: auto;
  }

  .future-content {
    max-width: 780px;
  }

  .future-title {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1.2;
    color: #2E3138;
    letter-spacing: -0.02em;
    margin-bottom: 2rem;
  }

  .future-narrative p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #475569;
    margin-bottom: 1.5rem;
  }

  .future-actions {
    margin-top: 2.5rem;
  }

  /* ==================== LATEST ARTICLES ==================== */
  .articles-section {
    padding: 5rem 0 6rem 0;
  }

  .articles-list {
    max-width: 780px;
    margin: 0 auto;
    border-top: 1px solid #EBE2D6;
  }

  .article-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0.5rem;
    border-bottom: 1px solid #EBE2D6;
    text-decoration: none;
    color: #2E3138;
    transition: all 0.2s ease;
  }

  .article-row:hover {
    color: #b68e54;
    padding-left: 1rem;
    background: rgba(182, 142, 84, 0.04);
  }

  .article-date {
    font-size: 0.85rem;
    color: #94A3B8;
    font-weight: 500;
    min-width: 100px;
  }

  .article-title {
    font-size: 1.05rem;
    font-weight: 600;
    flex: 1;
