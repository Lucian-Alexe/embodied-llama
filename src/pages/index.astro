---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getD1, getAllArticles } from '../lib/db';

const d1 = getD1(Astro.locals);
const allArticles = await getAllArticles(d1);
const publishedArticles = allArticles.filter((a) => a.status === 'published');

const seoSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://embodiedllama.com/#website',
      url: 'https://embodiedllama.com',
      name: 'Embodied Llama',
      description: 'Transformative somatic coaching, nervous system regulation, and body-centered practices.',
    },
    {
      '@type': ['ProfessionalService', 'HealthAndBeautyBusiness'],
      '@id': 'https://embodiedllama.com/#service',
      name: 'Embodied Llama Somatic Coaching',
      url: 'https://embodiedllama.com',
      logo: 'https://embodiedllama.com/assets/logo.svg',
      image: 'https://embodiedllama.com/assets/v3/photos/hero-forest-log.jpeg',
      description: 'Guiding individuals out of survival mode and into authentic self-alignment using nervous system regulation, somatic touch, TTT tapping, and body-centered awareness.',
      serviceType: 'Somatic Coaching',
      priceRange: '$$',
      areaServed: ['Chicago', 'United States', 'Worldwide (Remote)'],
      knowsAbout: [
        'Somatic Coaching',
        'Nervous System Regulation',
        'Trauma-Informed Somatics',
        'Vagus Nerve Grounding',
        'Body Awareness',
      ],
    },
  ],
};
---

<Layout
  title="Home"
  description="Embodied Llama — Somatic Coaching to step out of survival mode, regulate your nervous system, and reconnect with the wisdom of your body."
  schema={seoSchema}
>
  <!-- ==================== HERO AREA WITH CELESTIAL PATTERN & LEVITATING LLAMA ==================== -->
  <section class="hero-wrapper" id="home">
    <div class="hero-pattern-bg" aria-hidden="true"></div>

    <!-- Centered Levitating Llama & Brand Display -->
    <div class="hero-brand-center">
      <div class="hero-llama-levitate-wrap">
        <div class="llama-canvas">
          <img
            src="/assets/v3/hero-llama-mandala.png"
            alt="Embodied Llama Meditating Emblem with Celestial Stars"
            class="hero-llama-mandala"
            width="480"
            height="480"
            fetchpriority="high"
          />
        </div>
      </div>

      <h1 class="hero-brand-title">Embodied LLama</h1>
      <p class="hero-brand-subtitle">SOMATIC COACHING</p>
    </div>

    <!-- Hero Narrative Block: Forest Photo + Two Columns (Editorial Misalignment) -->
    <div class="hero-story-container">
      <div class="hero-media-col">
        <!-- Ambient Flower SVG behind photo -->
        <div class="hero-flower-decor" aria-hidden="true">
          <img src="/assets/flower.svg" alt="" width="520" height="520" />
        </div>
        <div class="hero-photo-wrapper">
          <img
            src="/assets/v3/photos/hero-forest-log.jpeg"
            alt="Somatic coach sitting on a mossy forest log in nature"
            class="hero-photo"
            width="440"
            height="580"
            fetchpriority="high"
          />
        </div>
      </div>

      <div class="hero-text-col">
        <h2 class="hero-headline">
          <span class="headline-light">Returning to the</span>
          <span class="headline-bold">wisdom of your body</span>
        </h2>

        <div class="hero-two-columns">
          <div class="hero-col">
            <p class="hero-lead">
              <strong>Real transformation happens when we fully inhabit our physical experience.</strong>
            </p>
            <p>
              When we bring loving attention to the body, we unlock its natural capacity to heal and expand.
            </p>
            <p>
              Whether you are moving through a major transition, finding your way through stress, wanting to foster self attunement and reconnecting with your true self, <em>somatic coaching meets you right where you are</em>. It offers a path to feel at home in your body and make choices that are aligned with your deepest truth, as you dive into the wisdom of your soma.
            </p>
          </div>

          <div class="hero-col">
            <p>
              This process is about creating tangible internal resources that become part of your daily life. We build a sense of safety in your nervous system and inner groundedness that gives you a steady anchor when life gets stressful.
            </p>
            <p>
              As you learn to meet your emotions with warmth and curiosity, you dissolve old habits that limited your capacity to thrive and make room for genuine joy and presence, allowing you to move through life feeling centered.
            </p>
          </div>
        </div>

        <div class="hero-cta-group">
          <a href="https://zcal.com" target="_blank" rel="noopener noreferrer" class="btn-pill-dark hero-btn-book">
            <span>Book</span>
            <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="#about" class="btn-pill-sand hero-btn-about">
            <span>Learn more about me</span>
          </a>
        </div>
      </div>
    </div>

    <!-- ==================== "WHY LLAMA?" CARD (FULL CONTAINER WIDTH, NO SHADOW, NO BORDER) ==================== -->
    <div class="why-llama-container">
      <div class="why-llama-card">
        <div class="why-llama-media">
          <img
            src="/assets/v3/why-llama-lotus.png"
            alt="Llama in lotus yoga pose line art"
            class="why-llama-lotus"
            width="170"
            height="170"
            loading="lazy"
          />
        </div>
        <div class="why-llama-content">
          <h3 class="why-llama-title">Why LLama?</h3>
          <p class="why-llama-text">
            My practice is named after the llama for a special reason. Llamas are not only cute and gentle, beneath their soft exterior they are also incredibly strong and resilient. They carry heavy loads through difficult paths with steadiness. They teach us about the profound value of community and service while they also remind us to protect our energy when our limits are pushed. They are experts at setting boundaries with humor! Llamas show us that we can be soft and compassionate while staying rooted in our power.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== "THE MAGIC" SECTION ==================== -->
  <section class="magic-section" id="magic">
    <div class="magic-container">
      <!-- Section Header with Exact PDF Stars Cluster -->
      <div class="magic-header-block">
        <div class="magic-stars-cluster" aria-hidden="true">
          <img src="/assets/v3/magic-stars-cluster.svg" alt="" width="75" height="69" />
        </div>
        <h2 class="magic-title">
          How the <strong class="magic-title-emphasis">magic</strong> happens...
        </h2>
      </div>

      <!-- Content Grid: Body Text + Photo (Misaligned from Heading) -->
      <div class="magic-top-grid">
        <div class="magic-intro">
          <p class="magic-lead">
            <strong>As a Somatic Coach, I offer a warm compassionate environment where every part of you is welcome.</strong>
          </p>
          <div class="magic-body-paragraphs">
            <p>
              We focus on shifting away from self-criticism toward self-compassion. Together, we guide your nervous system out of survival mode into safety, using practical grounding techniques. We create a safe space for feelings to move through freely, and allow old emotional tension to release safely.
            </p>
            <p>
              Because your healing journey is completely unique to you, we co-create a personalized program tailored entirely to what you need in the present moment. Rooted in what feels most supportive for you, we can draw from a rich blend of integrative modalities. In our sessions, we can incorporate gentle yoga, different breathing techniques, somatic touch, body scans and TTT tapping. We can also include movement, visualization and NLP along with other intuitive tools.
            </p>
          </div>
        </div>

        <div class="magic-media-frame">
          <div class="magic-photo-card">
            <img
              src="/assets/v3/photos/magic-stone-arch.jpeg"
              alt="Yoga pose beneath ancient stone archway in nature"
              class="magic-arch-photo"
              width="450"
              height="580"
              loading="lazy"
            />
            <!-- Exact PDF Stars placed outside the bottom right corner -->
            <div class="magic-corner-stars" aria-hidden="true">
              <img src="/assets/v3/magic-corner-stars.svg" alt="" width="141" height="130" />
            </div>
          </div>
        </div>
      </div>

      <div class="magic-divider-line" aria-hidden="true"></div>

      <div class="magic-quote-center">
        <p class="magic-quote-text">
          <strong>Rather than just managing symptoms, these tools help you build true internal resilience and reconnect with your intuition, yourself and the world around you.</strong>
        </p>
        <p class="magic-weave-intro">Here is what we weave in our sessions:</p>
      </div>

      <!-- 4 Weave Cards (Flat, No Shadows) -->
      <div class="weave-grid">
        <div class="weave-card">
          <div class="weave-icon-wrap">
            <img
              src="/assets/icon-1.svg"
              alt="Geometric flower icon"
              class="weave-icon"
              width="68"
              height="68"
              loading="lazy"
            />
          </div>
          <h3 class="weave-card-title">Nervous System<br />Regulation</h3>
          <p class="weave-card-desc">
            Shifting out of hypervigilance into practical grounding techniques that soothe anxiety and teach your system that it is safe to relax.
          </p>
        </div>

        <div class="weave-card">
          <div class="weave-icon-wrap">
            <img
              src="/assets/icon-2.svg"
              alt="Connected circles icon"
              class="weave-icon"
              width="68"
              height="68"
              loading="lazy"
            />
          </div>
          <h3 class="weave-card-title">Befriending Your<br />Body</h3>
          <p class="weave-card-desc">
            Shifting from resisting or judging your physical self to treating your body as a trusted ally.
          </p>
        </div>

        <div class="weave-card">
          <div class="weave-icon-wrap">
            <img
              src="/assets/icon-3.svg"
              alt="Center horizon icon"
              class="weave-icon"
              width="68"
              height="68"
              loading="lazy"
            />
          </div>
          <h3 class="weave-card-title">Creating Space for<br />Emotion</h3>
          <p class="weave-card-desc">
            Allowing feelings to move through you freely, turning emotional weight into clarity and wisdom.
          </p>
        </div>

        <div class="weave-card">
          <div class="weave-icon-wrap">
            <img
              src="/assets/icon-4.svg"
              alt="Awakened eye icon"
              class="weave-icon"
              width="68"
              height="68"
              loading="lazy"
            />
          </div>
          <h3 class="weave-card-title">Reclaiming Your Voice & Reconnecting with Creation</h3>
          <p class="weave-card-desc">
            Moving beyond daily survival so you can speak your truth, align with your deepest desires, and actively design your future.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== "ABOUT ME" SECTION ==================== -->
  <section class="about-section" id="about">
    <div class="about-container">
      <h2 class="about-main-title">A little bit about me</h2>

      <!-- Part 1: Top Narrative + 3 Photos Collage (Misaligned like PDF) -->
      <div class="about-stage-grid">
        <div class="about-story-col">
          <div class="about-narrative-item">
            <h3 class="about-item-title">Proudly Mexican</h3>
            <p class="about-item-desc">
              I am deeply proud of my roots and love sharing the warm and vibrant energy of Mexico wherever I go.
            </p>
          </div>

          <div class="about-item-divider" aria-hidden="true"></div>

          <div class="about-narrative-item">
            <h3 class="about-item-title">Powered by</h3>
            <p class="about-item-desc">
              Dogs, good coffee, tarot readings, the beach, sound healing and cacao ceremonies. Also, full transparency, an iced Coke!
            </p>
          </div>

          <div class="about-item-divider" aria-hidden="true"></div>

          <div class="about-narrative-item">
            <h3 class="about-item-title">Rooted in Connection</h3>
            <p class="about-item-desc">
              Deep, authentic connection with my loved ones and community is what keeps my heart full.
            </p>
          </div>

          <div class="about-item-divider" aria-hidden="true"></div>

          <div class="about-narrative-item">
            <h3 class="about-item-title">Wanderer at Heart</h3>
            <p class="about-item-desc">
              I love traveling, exploring new cultures, and connecting with people. Relocating to Chicago was one of the most incredible and challenging experiences.
            </p>
          </div>

          <div class="about-item-divider" aria-hidden="true"></div>

          <div class="about-narrative-item">
            <h3 class="about-item-title">Movement is My First Language</h3>
            <p class="about-item-desc">
              Dance has been a part of my life since I was 5 years old. It has always been my safe place and where I feel most alive.
            </p>
          </div>
        </div>

        <div class="about-photos-col about-photos-part1">
          <div class="about-photos-stack">
            <div class="about-photo-card card-red-skirt">
              <img
                src="/assets/v3/photos/about-red-skirt.jpeg"
                alt="Portrait of coach in red skirt smiling warmly on balcony"
                width="280"
                height="340"
                loading="lazy"
              />
            </div>
            <div class="about-photo-card card-dog-woods">
              <img
                src="/assets/v3/photos/about-dog-woods.jpeg"
                alt="Smiling in the forest with a happy golden retriever"
                width="280"
                height="340"
                loading="lazy"
              />
            </div>
          </div>
          <div class="about-photos-side">
            <div class="about-photo-card card-beach-sunset">
              <img
                src="/assets/v3/photos/about-beach-sunset.jpeg"
                alt="Warrior pose at sunset on the beach"
                width="280"
                height="340"
                loading="lazy"
              />
            </div>
          </div>
        </div>
      </div>

      <!-- Part 2: 3 Photos + Credentials & Background -->
      <div class="about-stage-grid about-stage-inverted">
        <div class="about-photos-col about-photos-part2">
          <div class="about-photos-stack">
            <div class="about-photo-card card-pond-yoga">
              <img
                src="/assets/v3/photos/about-pond-yoga.jpeg"
                alt="Tree pose on stepping stones in a tranquil koi pond"
                width="280"
                height="340"
                loading="lazy"
              />
            </div>
            <div class="about-photo-card card-pumpkin-heart">
              <img
                src="/assets/v3/photos/about-pumpkin-heart.jpeg"
                alt="Smiling warmly through a heart frame of autumn pumpkins"
                width="280"
                height="340"
                loading="lazy"
              />
            </div>
          </div>
          <div class="about-photos-side">
            <div class="about-photo-card card-mandala-indoor">
              <img
                src="/assets/v3/photos/about-mandala-indoor.jpeg"
                alt="Meditation with sacred floral flower mandala"
                width="280"
                height="340"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <div class="about-story-col">
          <div class="about-narrative-item">
            <h3 class="about-item-title">Yoga and spirituality</h3>
            <p class="about-item-desc">
              I've practiced yoga for over 12 years, not only the postures but a way of life that goes beyond the mat. Completing 500 Yoga Teacher Training in India and Bali were deeply transformative experiences that make me who I am today. My spiritual practice is a loving foundation that helps me navigate life with hope.
            </p>
          </div>

          <div class="about-item-divider" aria-hidden="true"></div>

          <div class="about-narrative-item">
            <h3 class="about-item-title">Seeker & Soul Explorer</h3>
            <p class="about-item-desc">
              Fascinated by the depth of human consciousness, I am always learning. I love incorporating intuitive modalities like tarot and Quantum Healing as gentle tools for insight and inner growth.
            </p>
          </div>

          <div class="about-item-divider" aria-hidden="true"></div>

          <div class="about-narrative-item">
            <h3 class="about-item-title">10+ Years of Holding Space</h3>
            <p class="about-item-desc">
              I hold a <strong>bachelor's in Psychology and a master's in Psychoanalytic Psychotherapy</strong>. Before transitioning into somatic coaching, I spent over a decade working as a counselor in non-profits and private practices, specializing in relational and generational trauma. That journey brought me to <strong>mindfulness, EMDR, Brainspotting</strong>, and <strong>integrative somatic approaches</strong>. These tools shaped how I hold space today.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== UNIFIED "FUTURE THAT FEELS LIKE YOU" + OFFERINGS ==================== -->
  <section class="future-offerings-unified" id="offerings">
    <div class="unified-container">
      <!-- Part 1: Story + Buddha Statue Photo -->
      <div class="future-story-row">
        <div class="future-content">
          <h2 class="future-title">
            <span class="headline-light">Let's create a future</span>
            <span class="headline-bold">that feels like you</span>
          </h2>

          <p class="future-lead">
            <strong>My path to somatic coaching started while working with clients processing trauma.</strong>
          </p>

          <p>
            While I loved supporting them, we kept bumping into the same wall: retelling the story wasn't enough. They were still holding onto old survival patterns and a nervous system stuck in fight-or-flight. I knew there was something missing.
          </p>
          <p>
            Everything shifted when I found body-centered practices. I realized that transformation only happens when the body is included in the process, and this resonated so much more with my approach to healing. Movement has always been my personal medicine, so bringing body awareness into my work felt completely natural.
          </p>
          <p>
            As a somatic coach, my greatest joy is guiding people back to their most authentic selves. I know this path deeply because I've walked my own journey of learning to slow down, listen to my body's wisdom, and reconnect with my heart. I'm so honored to share this work with you!
          </p>
        </div>

        <div class="future-media">
          <img
            src="/assets/v3/photos/about-buddha-statue.jpeg"
            alt="Sitting in quiet presence in front of a majestic Buddha statue in nature"
            class="future-photo"
            width="480"
            height="580"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Part 2: Slider Navigation Controls (Aligned) -->
      <div class="slider-controls-bar">
        <div class="slider-controls" aria-label="Offerings slider controls">
          <button
            type="button"
            class="slider-btn slider-btn-prev"
            id="pricingPrevBtn"
            aria-label="Previous offering"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 19l-7-7 7-7" />
            </svg>
          </button>
          <div class="slider-dots" id="pricingSliderDots" role="tablist" aria-label="Select offering package">
            <button type="button" class="slider-dot is-active" data-index="0" role="tab" aria-selected="true" aria-label="Slide 1: Somatic Discovery"></button>
            <button type="button" class="slider-dot" data-index="1" role="tab" aria-selected="false" aria-label="Slide 2: Grounding Foundation"></button>
            <button type="button" class="slider-dot" data-index="2" role="tab" aria-selected="false" aria-label="Slide 3: Reconnection Journey"></button>
            <button type="button" class="slider-dot" data-index="3" role="tab" aria-selected="false" aria-label="Slide 4: Deep Immersion"></button>
          </div>
          <button
            type="button"
            class="slider-btn slider-btn-next"
            id="pricingNextBtn"
            aria-label="Next offering"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M9 5l7 7-7 7" />
            </svg>
          </button>
        </div>
      </div>

      <!-- CSS Scroll-Snap Slider Viewport -->
      <div class="pricing-slider-viewport" id="pricingSliderViewport" tabindex="0" role="region" aria-label="Offerings carousel">
        <!-- Package 1: Discovery -->
        <article class="pricing-card" data-card-index="0">
          <div class="pricing-card-icon-col">
            <div class="pricing-icon-wrap">
              <img
                src="/assets/v3/pricing-mandala-1.svg"
                alt="1 petal active mandala"
                class="pricing-icon"
                width="120"
                height="120"
                loading="lazy"
              />
            </div>
          </div>

          <div class="pricing-card-content-col">
            <h3 class="pricing-card-title">Somatic Discovery and Mapping Session</h3>
            <div class="pricing-tags-row">
              <span class="pricing-pill-badge">1 session × 75 min</span>
            </div>
            <p class="pricing-card-lead">
              Orienting to your nervous system's current state, exploring where you hold tension, and discovering gentle ways to move and breathe through overload.
            </p>
            <p class="pricing-card-note">
              Note: This single session serves as the gentle foundation for all follow-up containers.
            </p>
            <ul class="pricing-check-list">
              <li>
                <span class="check-bullet" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="#D9D7D3" stroke-width="1.6" />
                    <polyline points="8 12 11 15 16 9" stroke="#B68E54" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span>In-depth 1:1 intake mapping your body's stress, trauma, and burnout patterns.</span>
              </li>
              <li>
                <span class="check-bullet" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="#D9D7D3" stroke-width="1.6" />
                    <polyline points="8 12 11 15 16 9" stroke="#B68E54" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span>Guided practices to safely reconnect with your body's subtle physical sensations at your own pace.</span>
              </li>
              <li>
                <span class="check-bullet" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <circle cx="12" cy="12" r="10" stroke="#D9D7D3" stroke-width="1.6" />
                    <polyline points="8 12 11 15 16 9" stroke="#B68E54" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span>Learning simple grounding practices you can weave into your daily rhythm.</span>
              </li>
            </ul>
          </div>

          <div class="pricing-card-action-col">
            <div class="pricing-price-val">$144 USD</div>
            <a href="https://zcal.com" target="_blank" rel="noopener noreferrer" class="btn-pill-ochre pricing-book-btn">
              <span>Book</span>
              <span class="btn-arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </article>

        <!-- Package 2: Foundation -->
        <article class="pricing-card" data-card-index="1">
          <div class="pricing-card-icon-col">
            <div class="pricing-icon-wrap">
              <img
                src="/assets/v3/pricing-mandala-2.svg"
                alt="2 petals active mandala"
                class="pricing-icon"
                width="120"
                height="120"
                loading="lazy"
              />
