  <!-- Slider Synchronization Script -->
  <script>
    function setupPricingSlider() {
      const viewport = document.getElementById('pricingSliderViewport');
      const prevBtn = document.getElementById('pricingPrevBtn');
      const nextBtn = document.getElementById('pricingNextBtn');
      const dots = document.querySelectorAll('.slider-dot');
      const cards = viewport?.querySelectorAll('.pricing-card');

      if (!viewport || !dots.length) return;

      function updateActiveIndex(idx: number) {
        dots.forEach((dot, i) => {
          const isActive = i === idx;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-selected', String(isActive));
        });
      }

      if ('onscrollsnapchange' in HTMLElement.prototype) {
        viewport.addEventListener('scrollsnapchange', (e: any) => {
          const target = e.snapTargetInline || e.snapTargetBlock;
          if (target && target.dataset && target.dataset.cardIndex !== undefined) {
            updateActiveIndex(parseInt(target.dataset.cardIndex, 10));
          }
        });
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const target = entry.target as HTMLElement;
                const idx = parseInt(target.dataset.cardIndex || '0', 10);
                updateActiveIndex(idx);
              }
            });
          },
          { root: viewport, threshold: 0.6 }
        );

        cards?.forEach((card) => observer.observe(card));
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          if (cards && cards[idx]) {
            cards[idx].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        });
      });

      prevBtn?.addEventListener('click', () => {
        viewport.scrollBy({ left: -viewport.clientWidth * 0.9, behavior: 'smooth' });
      });

      nextBtn?.addEventListener('click', () => {
        viewport.scrollBy({ left: viewport.clientWidth * 0.9, behavior: 'smooth' });
      });
    }

    setupPricingSlider();
    document.addEventListener('astro:page-load', setupPricingSlider);
  </script>
