{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "embodied-llama-web",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "embodied_llama_db",
      "database_id": "local"
    }
  ]
}

